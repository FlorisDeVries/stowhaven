<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>FlorisDeV.BackupCore</RootNamespace>
        <AssemblyName>FlorisDeV.BackupCore</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
        <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.27.1" />
        <PackageReference Include="Dapr.AspNetCore" Version="1.18.5" />
        <PackageReference Include="Dapr.Client" Version="1.18.5" />
        <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
        <!-- Microsoft.Data.Sqlite 10.0.0 pins SQLitePCLRaw.bundle_e_sqlite3 2.1.11, which bundles a
             pre-3.50.2 SQLite affected by GHSA-2m69-gcr7-jv3q. Force the patched 2.1.12 (same API
             surface, just a newer bundled SQLite binary) until Microsoft.Data.Sqlite bumps it itself. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <!-- The Cosmos SDK needs Newtonsoft.Json at runtime for its internal serialization,
             even though application documents use the System.Text.Json serializer. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\contracts\FlorisDeV.BackupContracts.csproj" />
        <ProjectReference Include="..\logging\FlorisDeV.Logging.csproj" />
        <ProjectReference Include="..\security\FlorisDeV.Security.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- For the associated test project -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>FlorisDeV.BackupApi.Tests</_Parameter1>
        </AssemblyAttribute>
        <!-- Moq needs to subclass internals when they are mocked -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>