<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Gateway</RootNamespace>
        <AssemblyName>Gateway</AssemblyName>
        <Product>Stowhaven</Product>
        <Description>Stowhaven authentication and API gateway</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    </ItemGroup>

</Project>
