{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Information"
        },
        "Sampling": {
            "Enabled": false
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Information",
                "System": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [CorrelationId:{CorrelationId}] [User:{UserId}] {Message:lj}{NewLine}    {Properties:j}{NewLine}{Exception}"
                }
            }
        ]
    },
    "DaprHealth": {
        "EnablePubSubProbe": false
    },
    "OTEL_SERVICE_NAME": "backup-api-dev",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://dev-dashboard:18889",
    "OTEL_EXPORTER_ZIPKIN_ENDPOINT": "http://zipkin:9411/api/v2/spans",
    "Database": {
        "Provider": "Sqlite",
        "Sqlite": {
            "FilePath": "run/data/backup-state.db"
        }
    }
}
