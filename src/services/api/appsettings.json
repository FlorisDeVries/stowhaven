{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "Sampling": {
            "Enabled": true,
            "PathSamplingRates": {
                "/health/*": 20,
                "/healthz": 20,
                "/api/health/alive": 50,
                "/api/health/ready": 20
            },
            "SampledLogLevels": ["Debug", "Trace"]
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
                "System": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId"],
        "Properties": {
            "Application": "FlorisDeV.BackupApi"
        }
    },
    "OTEL_SERVICE_NAME": "backup-api",
    "OTEL_EXPORTER_ZIPKIN_ENDPOINT": "",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "",
    "OTEL_EXPORTER_AZURE_MONITOR_CONNECTION": "",
    "AllowedHosts": "*",
    "Backup": {
        "Sas": {
            "EnableIpRestriction": false
        }
    },
    "Operations": {
        "StaleStagingCleanup": {
            "OlderThanHours": 24,
            "MaxDeletes": 500,
            "DryRun": false
        }
    },
    "ReverseProxy": {
        "ForwardedHeaders": {
            "ForwardLimit": 1,
            "KnownProxies": [],
            "KnownNetworks": []
        }
    },
    "AzureAd": {
        "Instance": "https://login.microsoftonline.com/",
        "TenantId": "cf8adfe1-bb3b-4ef0-8ba9-44dcddb8ecb9",
        "ClientId": "906eb0e3-e351-47c0-a68a-690207f4cccb",
        "Audience": "api://906eb0e3-e351-47c0-a68a-690207f4cccb"
    }
}
