{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "Sampling": {
            "Enabled": true,
            "PathSamplingRates": {
                "/health/*": 20,
                "/healthz": 20,
                "/api/health/alive": 50,
                "/api/health/ready": 20
            },
            "SampledLogLevels": ["Debug", "Trace"]
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
                "System": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId"],
        "Properties": {
            "Application": "FlorisDeV.BackupWorker"
        }
    },
    "OTEL_SERVICE_NAME": "backup-worker",
    "OTEL_EXPORTER_ZIPKIN_ENDPOINT": "",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "",
    "OTEL_EXPORTER_AZURE_MONITOR_CONNECTION": "",
    "AllowedHosts": "*",
    "ReverseProxy": {
        "ForwardedHeaders": {
            "ForwardLimit": 1,
            "KnownProxies": [],
            "KnownNetworks": []
        }
    }
}
