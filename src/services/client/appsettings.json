{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "System": "Warning"
        }
    },
    "Serilog": {
        "Using": ["Serilog.Sinks.Console"],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": ["FromLogContext", "WithMachineName", "WithProcessId"],
        "Properties": {
            "Application": "FlorisDeV.BackupClient"
        }
    },
    "OTEL_SERVICE_NAME": "backup-client",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "",
    "OTEL_EXPORTER_AZURE_MONITOR_CONNECTION": "",
    "TelemetryFiltering": {
        "IgnoreRequests": [],
        "IgnoreDependencies": [],
        "IgnoreOperationNames": []
    },
    "Database": {
        "FilePath": null
    },
    "AzureAd": {
        "Instance": "https://login.microsoftonline.com/",
        "TenantId": "YOUR_TENANT_ID",
        "ClientId": "YOUR_CLIENT_APP_ID"
    },
    "BackupClient": {
        "BackupTargets": {
        },
        "IgnoreFilePath": ".backupignore",
        "MaxRetryAttempts": 3,
        "RetryDelayMs": 1000,
        "MaxRetryDelayMs": 30000,
        "BlobUploadTimeoutSeconds": 600,
        "MaxFailurePercentage": 5,
        "LockedFilePolicy": "SkipLocked",
        "Schedule": {
            "Enabled": false,
            "RunOnStartup": true,
            "IntervalMinutes": 1440
        },
        "Encryption": {
            "Mode": "ServerSideOnly",
            "RecoveryPhraseFilePath": null,
            "KdfIterations": 600000
        },
        "Restore": {
            "DeviceId": null,
            "DestinationPath": null,
            "LogicalPaths": [],
            "ListPageSize": 500,
            "OverwriteExisting": false
        }
    },
    "BackupApiClient": {
        "ApiUrl": "https://YOUR_GATEWAY_HOST.azurecontainerapps.io",
        "AuthenticationScope": "api://YOUR_GATEWAY_APP_ID/backup.access",
        "AuthenticationTenant": "YOUR_TENANT_ID",
        "RetryOptions": {
            "Retry": {
                "MaxRetryAttempts": 3,
                "Delay": "00:00:02",
                "BackoffType": "Exponential"
            }
        },
        "WakeUp": {
            "Enabled": true,
            "InitialDelaySeconds": 2,
            "MaxDelaySeconds": 30,
            "MaxWaitSeconds": 180,
            "ProbeTimeoutSeconds": 10,
            "RecheckIntervalSeconds": 60
        }
    }
}
