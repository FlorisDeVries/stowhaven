{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "OTEL_SERVICE_NAME": "backup-client",
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "OTEL_EXPORTER_AZURE_MONITOR_CONNECTION": "",
  "TelemetryFiltering": {
    "IgnoreRequests": [],
    "IgnoreDependencies": [],
    "IgnoreOperationNames": []
  },
  "Database": {
    "FilePath": null
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "YOUR_TENANT_ID_HERE",
    "ClientId": "YOUR_CLIENT_APP_ID_HERE"
  },
  "BackupClient": {
    "BackupTargets": {
      "user-profile": "C:\\Users\\YourUsername",
      "projects": "D:\\Projects",
      "photos": "E:\\Photos"
    },
    "IgnoreFilePath": null,
    "MaxParallelUploads": 4,
    "LargeFileThresholdBytes": 10485760,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "MaxRetryDelayMs": 30000,
    "HttpTimeoutSeconds": 300,
    "BlobUploadTimeoutSeconds": 600,
    "MaxFailurePercentage": 5,
    "LockedFilePolicy": "SkipLocked",
    "Schedule": {
      "Enabled": false,
      "RunOnStartup": true,
      "IntervalMinutes": 1440
    },
    "Encryption": {
      "Mode": "ServerSideOnly",
      "RecoveryPhraseFilePath": null,
      "KdfIterations": 600000
    },
    "Restore": {
      "DeviceId": null,
      "DestinationPath": "C:\\Restore",
      "LogicalPaths": [],
      "ListPageSize": 500,
      "OverwriteExisting": false
    }
  },
  "BackupApiClient": {
    "ApiUrl": "https://your-api-url.azurewebsites.net",
    "AuthenticationScope": "api://YOUR_API_APP_ID/backup.admin",
    "AuthenticationTenant": "YOUR_TENANT_ID_HERE",
    "RetryOptions": {
      "Retry": {
        "MaxRetryAttempts": 3,
        "Delay": "00:00:02",
        "BackoffType": "Exponential"
      }
    },
    "WakeUp": {
      "Enabled": true,
      "InitialDelaySeconds": 2,
      "MaxDelaySeconds": 30,
      "MaxWaitSeconds": 180,
      "ProbeTimeoutSeconds": 10,
      "RecheckIntervalSeconds": 60
    }
  }
}
