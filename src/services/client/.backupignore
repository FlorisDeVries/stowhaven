# Backup Ignore File
# Patterns use glob syntax (similar to .gitignore)
# Lines starting with # are comments
# Use ** to match any number of directories

# ===== System Files =====
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/$RECYCLE.BIN/**
**/System Volume Information/**

# ===== Temporary Files =====
**/*.tmp
**/*.temp
**/*.swp
**/*~
**/.tmp/**

# ===== Log Files =====
**/*.log
**/logs/**

# ===== Build Outputs =====
**/bin/**
**/obj/**
**/build/**
**/dist/**
**/out/**
**/target/**

# ===== Package Managers & Dependencies =====
**/node_modules/**
**/bower_components/**
**/.nuget/**
**/packages/**
**/__pycache__/**
**/venv/**
**/virtualenv/**
**/.venv/**

# ===== Version Control =====
**/.git/**
**/.svn/**
**/.hg/**

# ===== IDE & Editor Files =====
**/.vs/**
**/.vscode/**
**/.idea/**
**/*.suo
**/*.user
**/.project
**/.classpath

# ===== Caches =====
**/.cache/**
**/Cache/**
**/cache/**

# ===== Windows Specific =====
# Windows system (if backing up entire drive)
**/Windows/**
**/Program Files/**
**/Program Files (x86)/**
**/ProgramData/Microsoft/Windows/**
**/pagefile.sys
**/hiberfil.sys
**/swapfile.sys

# Windows user caches
**/AppData/Local/Temp/**
**/AppData/Local/Microsoft/Windows/INetCache/**
**/AppData/Local/Microsoft/Windows/Temporary Internet Files/**
**/AppData/Local/Packages/*/TempState/**
**/AppData/Local/CrashDumps/**

# Browser caches (Windows)
**/AppData/Local/Google/Chrome/User Data/*/Cache/**
**/AppData/Local/Google/Chrome/User Data/*/Code Cache/**
**/AppData/Local/Mozilla/Firefox/Profiles/*/cache2/**
**/AppData/Local/Microsoft/Edge/User Data/*/Cache/**

# ===== Unix/Linux/macOS Specific =====
# System directories (if backing up from root)
/proc/**
/sys/**
/dev/**
/run/**
/tmp/**
/var/tmp/**
/var/cache/**
/var/log/**

# Unix user caches
**/.cache/**
**/.local/share/Trash/**
**/Library/Caches/**
**/Library/Logs/**
**/.Trash/**

# Browser caches (Unix)
**/.mozilla/firefox/*/cache2/**
**/.config/google-chrome/*/Cache/**
**/Library/Application Support/Google/Chrome/*/Cache/**

# ===== Database Files (Local Dev) =====
# Uncomment if you don't want to backup local dev databases
# *.db
# *.sqlite

# ===== Add Your Custom Patterns Below =====

