# Stowhaven Ignore File
# Patterns use glob syntax (similar to .gitignore)
# Lines starting with # are comments
# Use ** to match any number of directories
#
# NOTE: This is a sensible default for developer workstations.
# For servers/production systems:
#   - Consider keeping log files (comment out **/*.log and var/log/**)
#   - Remove Windows/Program Files exclusions if needed
#   - Customize based on your specific backup requirements

# ===== System Files =====
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/$RECYCLE.BIN/**
**/System Volume Information/**

# ===== Temporary Files =====
**/*.tmp
**/*.temp
**/*.swp
**/*~
**/.tmp/**

# ===== Log Files =====
**/*.log
**/logs/**

# ===== Build Outputs =====
**/bin/**
**/obj/**
**/build/**
**/dist/**
**/out/**
**/target/**

# ===== Package Managers & Dependencies =====
**/node_modules/**
**/bower_components/**
**/.nuget/**
**/packages/**
**/__pycache__/**
**/venv/**
**/virtualenv/**
**/.venv/**

# ===== Language-Specific Caches =====
# Python
**/.pytest_cache/**
**/.mypy_cache/**
**/.ruff_cache/**
# Node/JavaScript
**/.npm/**
**/.pnpm-store/**
**/.yarn/cache/**
# Java/Gradle
**/.gradle/**
**/.m2/repository/**
# Rust
**/.cargo/registry/**
**/.cargo/git/**
**/target/debug/**
**/target/release/**

# ===== Version Control =====
**/.git/**
**/.svn/**
**/.hg/**

# ===== IDE & Editor Files =====
**/.vs/**
**/.vscode/**
**/.idea/**
**/*.suo
**/*.user
**/.project
**/.classpath
**/.history/**
**/.fleet/**

# ===== Caches =====
**/.cache/**
**/Cache/**
**/cache/**

# ===== Container & Infrastructure as Code =====
**/.docker/**
**/docker-data/**
**/.terraform/**
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/.serverless/**
**/.devcontainer/**

# ===== Crash Dumps & Diagnostics =====
**/*.dmp
**/*.stackdump
**/core
**/hs_err_pid*.log

# ===== Windows Specific =====
# Windows system (if backing up entire drive)
**/Windows/**
**/Program Files/**
**/Program Files (x86)/**
**/ProgramData/Microsoft/Windows/**
**/pagefile.sys
**/hiberfil.sys
**/swapfile.sys

# Windows user caches
**/AppData/Local/Temp/**
**/AppData/Local/Microsoft/Windows/INetCache/**
**/AppData/Local/Microsoft/Windows/Temporary Internet Files/**
**/AppData/Local/Packages/*/TempState/**
**/AppData/Local/CrashDumps/**

# Browser caches (Windows)
**/AppData/Local/Google/Chrome/User Data/*/Cache/**
**/AppData/Local/Google/Chrome/User Data/*/Code Cache/**
**/AppData/Local/Mozilla/Firefox/Profiles/*/cache2/**
**/AppData/Local/Microsoft/Edge/User Data/*/Cache/**

# ===== Unix/Linux/macOS Specific =====
# System directories (if backing up from root)
proc/**
sys/**
dev/**
run/**
tmp/**
var/tmp/**
var/cache/**
var/log/**

# Unix user caches
**/.local/share/Trash/**
**/Library/Caches/**
**/Library/Logs/**
**/.Trash/**

# Browser caches (Unix)
**/.mozilla/firefox/*/cache2/**
**/.config/google-chrome/*/Cache/**
**/Library/Application Support/Google/Chrome/*/Cache/**

# ===== Electron / Chromium App Caches =====
# Regenerable caches shared by all Chromium-based apps (VS Code, Discord, Slack,
# Teams, Obsidian, browsers, Azure Storage Explorer, ...). The plain "Cache"/"cache"
# dirs are already handled above; these are the space/caps variants that slip through.
**/Code Cache/**
**/GPUCache/**
**/DawnCache/**
**/GrShaderCache/**
**/CachedData/**
**/blob_storage/**
**/component_crx_cache/**
**/Service Worker/CacheStorage/**
**/Service Worker/ScriptCache/**

# ===== Cloud Sync Temporary Files =====
**/*.icloud
**/~$*
**/.dropbox.cache/**
**/OneDrive - */.849C9593-D756-4E56-8D6E-42412F2A707B/**

# ===== Stowhaven Self-Exclusion =====
# Don't backup the backup client itself to avoid recursion
**/FlorisDeV.BackupApi/**
**/FlorisDeV.BackupClient/**
**/backup-client/**
**/backup-api/bin/**
**/backup-api/obj/**
**/stowhaven/bin/**
**/stowhaven/obj/**

# ===== Gaming =====
# Steam
**/.steam/**
**/.local/share/Steam/steamapps/common/**
**/.local/share/Steam/ubuntu12_32/**
**/.local/share/Steam/ubuntu12_64/**
**/.local/share/Steam/steamrt32/**
**/.local/share/Steam/steamrt64/**
**/.local/share/Steam/Steam.log
**/AppData/Local/Steam/**
**/steamapps/common/**
**/Steam/logs/**
**/Steam/dumps/**
# Shader & pipeline caches
**/.local/share/Steam/steamapps/shadercache/**
**/AppData/Local/D3DSCache/**
**/AppData/Local/NvidiaCoreDumps/**
**/AppData/LocalLow/NVIDIA/PerDriverVersion/**
# Epic Games
**/.config/Epic/**
**/AppData/Local/EpicGamesLauncher/Saved/Logs/**
**/AppData/Local/EpicGamesLauncher/Saved/webcache/**
**/Epic Games/**
# GOG Galaxy
**/AppData/Local/GOG.com/Galaxy/webcache/**
**/GOG Games/**
# EA / Origin
**/.local/share/EA/**
**/AppData/Roaming/Origin/Logs/**
**/AppData/Local/Origin/Webcache/**
# Ubisoft Connect
**/AppData/Local/Ubisoft Game Launcher/Logs/**
**/AppData/Local/Ubisoft Game Launcher/cache/**
# Battle.net
**/AppData/Roaming/Battle.net/Logs/**
**/AppData/Local/Battle.net/**
# Lutris (Linux)
**/.local/share/lutris/runtime/**
# Heroic Games Launcher (Linux)
**/.config/heroic/GamesConfig/**
**/.var/app/com.heroicgameslauncher.hgl/**

# ===== AI / CLI Developer Tools =====
# Transient temp/cache dirs from AI coding assistants and CLI tools.
# Scoped to tmp/cache subdirectories so their configs/settings are still backed up.
# OpenAI Codex CLI
**/.codex/tmp/**
**/.codex/ipc/**
**/.codex/**/cache/**
# Add other AI/CLI tools' temp/cache dirs here as needed, e.g.:
# **/.gemini/tmp/**

# IDE / language-service host runtime state (regenerable; contains IPC sockets)
**/.ServiceHub/**
**/.IdentityService/**

