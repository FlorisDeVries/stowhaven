<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Product>Stowhaven</Product>
        <Description>Stowhaven backup and restore client</Description>
        <UserSecretsId>5ed2dfc4-d949-471e-b756-f5eef4dae4bd</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\..\common\contracts\FlorisDeV.BackupContracts.csproj"/>
        <ProjectReference Include="..\..\common\logging\FlorisDeV.Logging.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageReference Include="OpenTelemetry" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
        <PackageReference Include="Refit" Version="16.4.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="appsettings.Development.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
        <Content Include=".backupignore">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="install.sh">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- A non-executing capability check prevents an old/mixed payload from
         treating an unknown dashboard command as a backup invocation. -->
    <Target Name="WriteDashboardContract" AfterTargets="Publish">
        <PropertyGroup>
            <DashboardContractLayout>assemblies</DashboardContractLayout>
            <DashboardContractLayout Condition="'$(PublishSingleFile)' == 'true'">singleFile</DashboardContractLayout>
        </PropertyGroup>
        <ItemGroup>
            <DashboardContractArtifacts Include="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)"
                                        Condition="Exists('$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)')" />
            <DashboardContractArtifacts Include="$(PublishDir)$(TargetFileName)"
                                        Condition="'$(PublishSingleFile)' != 'true' and Exists('$(PublishDir)$(TargetFileName)')" />
        </ItemGroup>
        <GetFileHash Files="@(DashboardContractArtifacts)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="DashboardContractHashes" />
        </GetFileHash>
        <PropertyGroup>
            <DashboardContractFiles>@(DashboardContractHashes->'&quot;%(Filename)%(Extension)&quot;: &quot;%(FileHash)&quot;', ',')</DashboardContractFiles>
        </PropertyGroup>
        <WriteLinesToFile File="$(PublishDir)dashboard-contract.json"
                          Lines="{ &quot;reportingSchemaVersion&quot;: 1, &quot;backupStateSchemaVersion&quot;: 3, &quot;layout&quot;: &quot;$(DashboardContractLayout)&quot;, &quot;files&quot;: { $(DashboardContractFiles) } }"
                          Overwrite="true" />
    </Target>
</Project>
