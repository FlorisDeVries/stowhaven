@page "/commits/{CommitId:guid}"
@attribute [Authorize]
@inherits MonitoringPage

<PageTitle>Commit details · Stowhaven</PageTitle>
<a class="back-link" href="commits">← Commit jobs</a>
<div class="page-heading"><div><p class="eyebrow">COMMIT DETAILS</p><h1>Job <span class="mono">@Display.Short(CommitId)</span></h1><p class="subtitle">Processing progress and file-level results.</p></div><button class="button" disabled="@Busy" @onclick="() => RunAsync(LoadAsync)">↻ Refresh</button></div>
<RequestState Busy="Busy" Error="@Error" />
@if (details is not null)
{
    var commit = details.Commit;
    <div class="panel detail-panel"><div class="panel-heading"><h2>Job summary</h2><StatusBadge Value="commit.Status" /></div>
        <dl class="detail-grid"><div><dt>Commit ID</dt><dd class="mono">@commit.CommitId</dd></div><div><dt>Device ID</dt><dd><a class="mono" href="@($"devices/{commit.DeviceId}")">@commit.DeviceId ↗</a></dd></div><div><dt>Backup run</dt><dd><a class="mono" href="@($"runs/{commit.DeviceId}/{commit.RunId}")">@commit.RunId ↗</a></dd></div><div><dt>Started</dt><dd>@Display.Time(commit.CreatedAt)</dd></div><div><dt>Last updated</dt><dd>@Display.Time(commit.UpdatedAt)</dd></div><div><dt>Completed</dt><dd>@Display.Time(commit.CompletedAt)</dd></div><div><dt>Attempts</dt><dd>@commit.AttemptCount</dd></div><div><dt>Next retry</dt><dd>@Display.Time(commit.NextRetryAt)</dd></div><div><dt>Dead-lettered</dt><dd>@Display.Time(commit.DeadLetteredAt)</dd></div></dl>
        <div class="job-progress"><div><strong>@Display.Number(commit.FilesProcessed) / @Display.Number(commit.TotalFiles) files processed</strong><span>@Display.Percent(commit.FilesProcessed, commit.TotalFiles)%</span></div><progress value="@(commit.FilesProcessed ?? 0)" max="@Math.Max(1, commit.TotalFiles)" aria-label="Commit progress"></progress></div>
        <div class="progress-counts"><span>@details.Progress.Pending pending</span><span>@details.Progress.Moved moved</span><span>@details.Progress.StateUpdated state updated</span><span class="success-text">@details.Progress.Succeeded succeeded</span><span class="danger-text">@details.Progress.Failed failed</span></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(commit.Error)) { <div class="notice danger"><strong>@(commit.FailureCategory ?? "Processing error")</strong><p class="error-detail">@commit.Error</p></div> }
    @if (commit.Status == CommitJobStatus.Failed)
    {
        <div class="panel retry-panel"><div><h2>Retry this failed job</h2><p>Requeue this commit and start a new attempt sequence.</p></div>
            @if (confirmRetry) { <div class="retry-confirm" role="group" aria-label="Confirm retry"><span>Requeue this commit now?</span><button class="button primary" disabled="@Busy" @onclick="RetryAsync">Confirm retry</button><button class="button" disabled="@Busy" @onclick="() => confirmRetry = false">Cancel</button></div> }
            else { <button class="button" disabled="@Busy" @onclick="() => confirmRetry = true">Retry job</button> }
        </div>
    }
    @if (!details.ManifestAvailable) { <div class="notice neutral">@(details.ManifestUnavailableReason ?? "The submitted manifest is no longer available. Recorded commit progress remains available below.")</div> }
    <div class="panel"><div class="panel-heading"><h2>Recorded file progress</h2><span class="muted">@details.Progress.Total tracked files</span></div>
        @if (files is not null)
        {
            <div class="table-scroll"><table><thead><tr><th>File</th><th>Status</th><th>Updated</th><th>Error</th></tr></thead><tbody>
                @foreach (var file in files.Files) { <tr @key="file.UniqueFileId"><td class="file-path">@file.LogicalPath</td><td><StatusBadge Value="file.Status" /></td><td class="timestamp">@Display.Time(file.UpdatedAt)</td><td class="error-detail">@(file.Error ?? "—")</td></tr> }
            </tbody></table></div>
            @if (files.Files.Count == 0) { <div class="empty-state">No file progress has been recorded yet.</div> }
            <Pager Cursor="cursor" NextToken="@files.NextContinuationToken" Busy="Busy" Previous="PreviousAsync" Next="NextAsync" />
        }
    </div>
}
@code {
    [Parameter] public Guid CommitId { get; set; }
    private Guid loadedId;
    private CommitJobDetailsResponse? details;
    private ListCommitFileProgressResponse? files;
    private readonly PageCursor cursor = new();
    private bool confirmRetry;
    protected override async Task LoadAsync()
    {
        if (loadedId != CommitId) { cursor.Reset(); details = null; files = null; confirmRetry = false; loadedId = CommitId; }
        details = await Api.CommitAsync(CommitId, Lifetime.Token);
        await LoadFilesAsync();
    }
    private async Task LoadFilesAsync() => files = await Api.CommitFilesAsync(CommitId, cursor.Current, Lifetime.Token);
    private async Task NextAsync()
    {
        if (files?.NextContinuationToken is not { } token) return;
        cursor.Next(token); files = null;
        await RunAsync(LoadFilesAsync);
    }
    private async Task PreviousAsync() { cursor.Back(); files = null; await RunAsync(LoadFilesAsync); }
    private async Task RetryAsync() => await RunAsync(async () =>
    {
        confirmRetry = false;
        await Api.RetryAsync(CommitId, Lifetime.Token);
        cursor.Reset();
        await LoadAsync();
    });
}
